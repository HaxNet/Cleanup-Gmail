{
  "manifest_version": 3,
  "key": "",
  "name": "Cleanup Gmail — Minimal UI",
  "version": "1.3.7",
  "description": "Strip Gmail down to a clean, minimal, distraction-free interface. Toggle away clutter, set your own accent color, font, and density.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "css": [
        "gmail.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Cleanup Gmail",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
